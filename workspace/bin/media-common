#!/usr/bin/env bash
# Shared, non-secret media helper functions. This file is sourced by workspace commands.
set -euo pipefail

readonly MEDIA_AUDIOBOOKS_SOURCE="${MEDIA_AUDIOBOOKS_SOURCE:-/media/audiobooks}"
readonly MEDIA_EBOOKS_SOURCE="${MEDIA_EBOOKS_SOURCE:-/media/ebooks}"
readonly TEST_MEDIA_ROOT="${TEST_MEDIA_ROOT:-/workspace-test-media}"

media_source_for() {
  case "${1:?media kind required}" in
    audiobook) printf '%s\n' "$MEDIA_AUDIOBOOKS_SOURCE" ;;
    ebook) printf '%s\n' "$MEDIA_EBOOKS_SOURCE" ;;
    *) echo "unsupported media kind" >&2; return 64 ;;
  esac
}

media_destination_for() {
  case "${1:?media kind required}" in
    audiobook) printf '%s\n' "$TEST_MEDIA_ROOT/audiobooks" ;;
    ebook) printf '%s\n' "$TEST_MEDIA_ROOT/ebooks" ;;
    *) echo "unsupported media kind" >&2; return 64 ;;
  esac
}

initialize_test_media() {
  install -d -m 0700 "$TEST_MEDIA_ROOT"/{audiobooks,ebooks,downloads,library,evidence}
}

assert_safe_scratch_root() {
  local resolved base tmpdir
  resolved=$(realpath -m "$TEST_MEDIA_ROOT")
  # Recognized scratch roots (real media under /media/... can never match):
  #   /workspace-test-media               canonical Coder tmpfs scratch
  #   /workspaces/*/.workspace-test-media devcontainer adapter layout
  #   <tmp>/.mediatest-*                  bounded offline/self-test scratch
  if [[ $resolved == /workspace-test-media || $resolved == /workspaces/*/.workspace-test-media ]]; then
    return 0
  fi
  if [[ ${MEDIA_SELF_TEST:-0} == 1 ]]; then
    base=$(basename "$resolved")
    tmpdir=${TMPDIR:-/tmp}; tmpdir=${tmpdir%/}
    if [[ $base == .mediatest-* && $resolved == "$tmpdir"/.mediatest-* || $resolved == "/tmp/.mediatest-"* ]]; then
      return 0
    fi
  fi
  echo "refusing unsafe scratch root" >&2
  return 65
}
