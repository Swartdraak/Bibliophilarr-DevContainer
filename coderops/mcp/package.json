{
  "name": "@bibliophilarr/coderops-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CoderOps MCP server and CLI for Bibliophilarr",
  "bin": {
    "coderops": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "doctor": "node dist/src/cli.js doctor",
    "inventory": "node dist/src/cli.js inventory",
    "capabilities": "node dist/src/cli.js capabilities",
    "verify": "npm run build && node --test dist/test/*.test.js",
    "test": "npm run verify",
    "mcp": "node dist/src/server.js",
    "generate:adapters": "node dist/src/cli.js generate-adapters"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.11",
    "typescript": "^5.9.2"
  }
}